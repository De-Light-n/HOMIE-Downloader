rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Колекція для всіх дій користувачів
    match /userActions/{actionId} {
      allow read: if true
      
      allow create: if true
    }
    
    match /userAnalytics/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Допоміжна функція для перевірки адміністратора
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Додаткові правила для інших колекцій, якщо вони є
    match /{document=**} {
      allow read, write: if true; // За замовчуванням забороняємо все інше
    }
  }
}